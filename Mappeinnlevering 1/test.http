# AUTH - ME
# Verify that the logged in user gets id, email, name and roles.
# Expected result: 200 OK
GET http://localhost:5221/api/auth/me
Authorization: Bearer {{token}}

###

# AUTH - ME WITHOUT TOKEN
# Expected result: 401 Unauthorized
GET http://localhost:5221/api/auth/me



###

# ANALYTICS - PRICE SUGGESTION
# Expected result: 200 OK
GET http://localhost:5221/api/analytics/price-suggestion?categoryId=1&condition=Good
Authorization: Bearer {{token}}

###

# ANALYTICS - PRICE SUGGESTION WITHOUT TOKEN
# Expected result: 401 Unauthorized
GET http://localhost:5221/api/analytics/price-suggestion?categoryId=1&condition=Good

###

# ANALYTICS - CATEGORY STATS
# Expected result: 200 OK
GET http://localhost:5221/api/analytics/categories/1/stats

###

