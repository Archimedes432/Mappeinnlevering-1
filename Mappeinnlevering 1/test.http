Authorization: Bearer {{token}}

###

# FAVORITES - REMOVE
# Expected result: 204 No Content
DELETE http://localhost:5221/api/favorites/1
Authorization: Bearer {{token}}

###

# FAVORITES - WITHOUT TOKEN
# Expected result: 401 Unauthorized
GET http://localhost:5221/api/favorites

